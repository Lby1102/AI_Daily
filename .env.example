# ===== 模块 2~4：文章总结 LLM（二选一）=====
# 方式 A：DeepSeek API（团队默认，填真实 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 方式 B：本地 OpenAI 兼容服务（零成本测试，已部署 Qwen3.5-9B 时自动启用）
LLM_PROVIDER=auto
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=qwen3.5-9b
LLM_LOCAL_API_KEY=local
# 可选：本地引擎目录；留空使用仓库同级 llm 目录
# LLM_DIR=C:/path/to/llm
LLM_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf

# 高级开关（JSON 默认开启；本地模型关闭思考）
SUMMARIZE_JSON_MODE=auto
SUMMARIZE_THINKING=auto
SUMMARIZE_MAX_RETRIES=8
SUMMARIZE_MAX_INPUT_CHARS=6000
SUMMARIZE_MAX_TOKENS=10000
# 篇幅控制（字）：每篇 400~600 字；开篇<=180 字；导语/结语<=260 字；段落 2~5 段
SUMMARIZE_MIN_ITEM_CHARS=400
SUMMARIZE_MAX_ITEM_CHARS=600
SUMMARIZE_MAX_LEAD_CHARS=180
SUMMARIZE_MAX_SECTION_CHARS=260
SUMMARIZE_MIN_PARAGRAPHS=2
SUMMARIZE_MAX_PARAGRAPHS=4

# ===== 模块 1：爬虫 =====
CRAWL_EDITION=morning
CRAWL_HOURS=24
CRAWL_MIN_SCORE=35

# ===== 图片与附件 =====
IMAGES_PER_NEWS=3
FETCH_IMAGES=true

# ===== 旧版微信公众号 API 模块（菜单网页上传无需填写）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选：标题/作者/摘要/原文地址（留空则取自动生成值）
ARTICLE_TITLE=
ARTICLE_AUTHOR=
ARTICLE_DIGEST=
ARTICLE_SOURCE_URL=

# ===== 每日自动生成 =====
SCHEDULE_TIME=09:00
AUTO_ENABLED=false
