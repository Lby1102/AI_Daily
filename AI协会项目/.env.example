# 微信公众号后台 -> 设置与开发 -> 基本配置
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret

# 文件路径可以是相对于项目根目录的路径
ARTICLE_HTML=content/article.html
COVER_IMAGE=content/test.png

# 标题也可以省略；省略时读取 HTML 中的 <title>
ARTICLE_TITLE=
ARTICLE_AUTHOR=社团名称
ARTICLE_DIGEST=
ARTICLE_SOURCE_URL=

# 0/1。留言能力仍取决于公众号自身权限
NEED_OPEN_COMMENT=0
ONLY_FANS_CAN_COMMENT=0

# 标准五段 cron：分 时 日 月 周
# 下例为每周一 09:00。程序必须保持运行；生产环境更推荐系统任务计划。
PUSH_CRON=0 9 * * 1
TIMEZONE=Asia/Shanghai

